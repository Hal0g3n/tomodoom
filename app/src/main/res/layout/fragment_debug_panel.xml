<?xml version="1.0" encoding="utf-8"?>
<!-- Hidden debug panel, shown as a bottom sheet when the Pets tab is long-pressed
     (ui/debug/DebugPanelFragment). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.debug.DebugPanelFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_title"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <TextView
            android:id="@+id/last_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Tomo will remember that (+10 HP)"
            tools:visibility="visible" />

        <!-- Pet -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_section_pet"
            android:textAppearance="@style/TextAppearance.Tomodoom.DebugSection" />

        <TextView
            android:id="@+id/pet_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Tomo (rabbit) · HP 50 / 100 · mood okay" />

        <TextView
            android:id="@+id/pet_equipped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Equipped: hat=cap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hp_minus_10"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_minus_10" />

            <Button
                android:id="@+id/hp_minus_1"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_minus_1" />

            <Button
                android:id="@+id/hp_plus_1"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_plus_1" />

            <Button
                android:id="@+id/hp_plus_10"
                style="@style/Widget.Tomodoom.DebugButton"
                android:layout_marginEnd="0dp"
                android:text="@string/debug_hp_plus_10" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/debug_set_hp_label"
            android:textAppearance="?attr/textAppearanceCaption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hp_set_0"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_preset_0" />

            <Button
                android:id="@+id/hp_set_30"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_preset_30" />

            <Button
                android:id="@+id/hp_set_50"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_preset_50" />

            <Button
                android:id="@+id/hp_set_80"
                style="@style/Widget.Tomodoom.DebugButton"
                android:text="@string/debug_hp_preset_80" />

            <Button
                android:id="@+id/hp_set_max"
                style="@style/Widget.Tomodoom.DebugButton"
                android:layout_marginEnd="0dp"
                android:text="@string/debug_hp_preset_max" />
        </LinearLayout>

        <Button
            android:id="@+id/unequip_all"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_unequip_all" />

        <!-- Doom scroll -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_section_doom_scroll"
            android:textAppearance="@style/TextAppearance.Tomodoom.DebugSection" />

        <TextView
            android:id="@+id/doom_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Usage Access: no · monitoring: no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/doom_rate_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:hint="@string/debug_doom_rate_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/doom_rate_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:maxLines="1"
                    tools:text="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/doom_rate_apply"
                style="@style/Widget.Tomodoom.DebugButton"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="0dp"
                android:text="@string/debug_doom_rate_apply" />
        </LinearLayout>

        <Button
            android:id="@+id/doom_minute"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:layout_marginTop="8dp"
            tools:text="Simulate 1 minute (−1 HP)" />

        <Button
            android:id="@+id/doom_warning"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_doom_warning" />

        <Button
            android:id="@+id/usage_settings"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_usage_settings" />

        <!-- Chat / MCP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_section_chat"
            android:textAppearance="@style/TextAppearance.Tomodoom.DebugSection" />

        <TextView
            android:id="@+id/chat_backend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Chat backend: offline mock bot" />

        <Button
            android:id="@+id/quiz_pass"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:layout_marginTop="8dp"
            android:text="@string/debug_quiz_pass" />

        <Button
            android:id="@+id/quiz_replay"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_quiz_replay" />

        <Button
            android:id="@+id/new_conversation"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_new_conversation" />

        <!-- Stats -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_section_stats"
            android:textAppearance="@style/TextAppearance.Tomodoom.DebugSection" />

        <Button
            android:id="@+id/stats_demo"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_stats_demo" />

        <Button
            android:id="@+id/stats_clear"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:text="@string/debug_stats_clear" />

        <!-- App -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/debug_section_app"
            android:textAppearance="@style/TextAppearance.Tomodoom.DebugSection" />

        <TextView
            android:id="@+id/app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBody2"
            tools:text="Version 1.0 (1) · debug build" />

        <Button
            android:id="@+id/reset"
            style="@style/Widget.Tomodoom.DebugWideButton"
            android:layout_marginTop="8dp"
            android:text="@string/debug_reset" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
