<?xml version="1.0" encoding="utf-8"?>
<!-- Pets page: the pet fills the page; the health bar floats over its bottom on a transparent card.
     Usage Access lives in onboarding and the Settings page.
     Customisation is its own page (fragment_customise.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pets.PetsFragment">

    <!-- Pet viewport: fills the page behind the cards. The pet itself is drawn behind the pager
         (PetStage), lined up with this view, which forwards its touches. Keep it transparent and
         add no children here. -->
    <com.example.tomodoom.ui.PetViewport
        android:id="@+id/pet_viewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/pet_viewport_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Health bar, below the rabbit -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hp_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/hp_card_background"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pet_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    tools:text="Tomo" />

                <TextView
                    android:id="@+id/pet_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceSubtitle2"
                    android:textColor="@color/slate_grey"
                    tools:text="@string/pet_status_okay" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/hp_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@color/eggshell"
                app:trackCornerRadius="@dimen/hp_bar_corner_radius"
                app:trackThickness="@dimen/hp_bar_thickness"
                tools:progress="50" />

            <TextView
                android:id="@+id/hp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBody2"
                tools:text="HP 50 / 100" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
