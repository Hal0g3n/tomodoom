<?xml version="1.0" encoding="utf-8"?>
<!-- A fenced code block in a bot bubble (ChatAdapter): language label, Copy, and the code in a
     horizontal scroller so long lines don't wrap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_chat_code_block"
    android:minWidth="180dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/code_language"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/chat_code_block_label"
            tools:text="python" />

        <TextView
            android:id="@+id/code_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="36dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/chat_code_copy"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/chat_code_block_text"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/code_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="true">

        <TextView
            android:id="@+id/code_text"
            style="@style/Widget.Tomodoom.ChatCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textIsSelectable="true"
            tools:text="print(&quot;hello&quot;)" />
    </HorizontalScrollView>
</LinearLayout>
