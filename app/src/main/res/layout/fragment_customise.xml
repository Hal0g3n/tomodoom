<?xml version="1.0" encoding="utf-8"?>
<!-- Customise page: a live pet preview above the slot tabs and the item grid. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.customise.CustomiseFragment">

    <!-- Pet preview: owned entirely by ManiengineAssetRenderer. Add no children here. -->
    <FrameLayout
        android:id="@+id/pet_viewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_pet_viewport"
        android:contentDescription="@string/pet_viewport_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/slot_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pet_viewport"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <!-- Two columns of item circles for the selected slot. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/item_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slot_tabs"
        app:spanCount="2"
        tools:listitem="@layout/item_accessory_circle" />
</androidx.constraintlayout.widget.ConstraintLayout>
