<?xml version="1.0" encoding="utf-8"?>
<!-- Settings page: pet name, pet species, tracked apps and the chat text size. Cards reuse the
     Stats card style; colours come from the theme (CLAUDE.md §6.3). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    tools:context=".ui.settings.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            tools:targetApi="p" />

        <!-- 1. Pet name -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tomodoom.StatsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_name_title"
                    android:textAppearance="@style/TextAppearance.Tomodoom.StatsCardTitle" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/pet_name_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/onboarding_name_hint"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:counterEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/pet_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pet_name_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_name_save"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Pet species -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tomodoom.StatsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_pet_title"
                    android:textAppearance="@style/TextAppearance.Tomodoom.StatsCardTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_pet_text"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pet_choices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_pet_choice" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Tracked apps -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tomodoom.StatsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_apps_title"
                    android:textAppearance="@style/TextAppearance.Tomodoom.StatsCardTitle" />

                <TextView
                    android:id="@+id/apps_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_apps_text"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <TextView
                    android:id="@+id/apps_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Tomodoom.StatsTileValue"
                    tools:text="8 apps watched" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/usage_access_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/usage_access_open_settings"
                        android:visibility="gone"
                        app:cornerRadius="16dp"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/choose_apps_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usage_access_choose_apps"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Chat text size -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tomodoom.StatsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_chat_title"
                        android:textAppearance="@style/TextAppearance.Tomodoom.StatsCardTitle" />

                    <TextView
                        android:id="@+id/chat_size_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Tomodoom.StatsTileValue"
                        tools:text="100%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/chat_size_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/settings_chat_title"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="5"
                    app:labelBehavior="gone" />

                <!-- Preview: a bot bubble at the chosen size. -->
                <TextView
                    android:id="@+id/chat_size_preview"
                    style="@style/Widget.Tomodoom.ChatBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bubble_bot"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/settings_chat_preview"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Background music volume -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Tomodoom.StatsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_music_title"
                        android:textAppearance="@style/TextAppearance.Tomodoom.StatsCardTitle" />

                    <TextView
                        android:id="@+id/music_volume_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Tomodoom.StatsTileValue"
                        tools:text="50%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/music_volume_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/settings_music_title"
                    android:stepSize="10"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:labelBehavior="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
