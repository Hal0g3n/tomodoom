<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pet viewport border (bg_pet_viewport). HtmlManiengineRenderer insets its WebView by this
         much so the border stays visible. -->
    <dimen name="pet_viewport_stroke">2dp</dimen>
    <!-- Corner radius of the bordered pet viewport (bg_pet_viewport). PetStage rounds the pet's
         transition frame to match it. -->
    <dimen name="pet_viewport_corner_radius">16dp</dimen>
    <!-- Side inset of the pet's rotate area where there is no health bar to line up with. Matches
         the health bar card's margin on the Pets page. -->
    <dimen name="pet_model_box_inset">16dp</dimen>
    <!-- Pets health bar (hp_progress): a thick rounded pill. -->
    <dimen name="hp_bar_thickness">14dp</dimen>
    <dimen name="hp_bar_corner_radius">7dp</dimen>
    <!-- How far the open bottom bar tab's enlarged icon rises (MainActivity). -->
    <dimen name="nav_icon_lift">4dp</dimen>
    <!-- Chat bubble text (also the LaTeX size, ChatMarkdown) -->
    <dimen name="chat_bubble_text_size">17sp</dimen>
    <dimen name="chat_code_text_size">14sp</dimen>
</resources>
