<resources>
    <!-- Base application theme. Light only: the app does not follow system dark mode. No action
         bar: each page supplies its own header (the HP card on Pets). -->
    <style name="Theme.Tomodoom" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/charcoal</item>
        <item name="colorPrimaryVariant">@color/jet</item>
        <item name="colorOnPrimary">@color/floral_white</item>
        <!-- Secondary brand color (also tints progress bars, inputs and other controls). -->
        <item name="colorSecondary">@color/charcoal</item>
        <item name="colorSecondaryVariant">@color/jet</item>
        <item name="colorOnSecondary">@color/floral_white</item>
        <!-- Backgrounds and surfaces. -->
        <item name="android:windowBackground">@color/floral_white</item>
        <item name="android:colorBackground">@color/floral_white</item>
        <item name="colorSurface">@color/floral_white</item>
        <item name="colorOnBackground">@color/jet</item>
        <item name="colorOnSurface">@color/jet</item>
        <!-- Text. -->
        <item name="android:textColorPrimary">@color/jet</item>
        <item name="android:textColorSecondary">@color/slate_grey</item>
        <item name="android:textColorHint">@color/slate_grey</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
