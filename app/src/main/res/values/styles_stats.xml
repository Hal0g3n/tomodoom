<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Stats page (fragment_stats.xml): flat cards with a visible 2dp eggshell border (§6.3). -->
    <style name="Widget.Tomodoom.StatsCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardBackgroundColor">@color/stats_card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeColor">@color/stats_card_stroke</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="TextAppearance.Tomodoom.StatsCardTitle" parent="TextAppearance.Tomodoom.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- The big number on a card, e.g. the time since the last doom-scroll. -->
    <style name="TextAppearance.Tomodoom.StatsHero" parent="TextAppearance.Tomodoom.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextAppearance.Tomodoom.StatsTileValue" parent="TextAppearance.Tomodoom.Subtitle1">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
</resources>
