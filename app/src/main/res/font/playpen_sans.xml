<?xml version="1.0" encoding="utf-8"?>
<!-- Bundled static weights. AppCompat attrs for API 24-25; font-v26/ has the framework copy. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/playpen_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        app:font="@font/playpen_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
